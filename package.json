{
  "name": "@cytoscape-web/network-analyzer",
  "description": "Network Analyzer calculates topological properties of a network (degree distribution, clustering coefficients, centrality, etc.)",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Cytoscape Consortium",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cytoscape/network-analyzer-cw.git"
  },
  "homepage": "https://github.com/cytoscape/network-analyzer-cw#readme",
  "keywords": [
    "graph analysis"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "//cyweb": [
    "This app's identity, written ONCE. The Module Federation container name,",
    "the CyApp.id, the dev server port and the dev install manifest all read",
    "from here (see vite.config.ts and virtual:cyweb-app-meta)."
  ],
  "cyweb": {
    "id": "networkAnalyzer",
    "displayName": "Network Analyzer",
    "port": 5556
  },
  "scripts": {
    "build": "vite build",
    "build:zip": "cross-env CYWEB_APP_ZIP=1 vite build",
    "dev": "vite",
    "verify": "cyweb-app verify",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsc -p tsconfig.test.json && node -e 'require(\"fs\").writeFileSync(\"dist-test/package.json\",JSON.stringify({type:\"commonjs\"}))' && node --test 'dist-test/**/*.test.js'"
  },
  "//peerDependencies": [
    "Provided by the HOST as Module Federation singletons — the share block",
    "uses `import: false`, so no fallback copy is bundled. Import only the",
    "package ROOTS (e.g. '@mui/material', never '@mui/material/Box'), or a",
    "second copy gets bundled and the no-shared-payload gate fails the build.",
    "@mui/icons-material is banned outright; see src/components/icons.tsx."
  ],
  "peerDependencies": {
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@mui/material": "^5.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "//devDependencies": [
    "@cytoscape-web/api-types is a file: link to the sibling cytoscape-web",
    "checkout: the modal-launcher slot types (RegisterModalOptions,",
    "ModalHostProps, openModal) are not in the published 1.0.0-beta.3 — run",
    "`npm run build:api-types` in cytoscape-web (Node 24) before",
    "installing/typechecking here. Restore a semver range once",
    "1.0.0-beta.4 is published."
  ],
  "devDependencies": {
    "@cytoscape-web/api-types": "file:../cytoscape-web/packages/api-types",
    "@cytoscape-web/app-runtime": "0.4.0-next.1",
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@module-federation/vite": "1.16.8",
    "@mui/material": "^5.18.0",
    "@types/cytoscape": "^3.21.0",
    "@types/cytoscape-euler": "^1.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "adm-zip": "^0.5.10",
    "cross-env": "^10.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3",
    "vite": "8.0.13"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-euler": "^1.2.4",
    "plotly.js": "^3.7.0",
    "react-chart-editor": "^0.46.1"
  }
}
